# The bench image installs tools and nothing else — it never COPYs the
# repository, because compose bind-mounts it at run time instead. So this file
# exists purely to keep the build context small: without it Docker uploads
# every object file in build/ and build-ubsan/ on each image build, for an
# image that does not want a single one of them.
build/
build-*/
.git/
.vs/
.idea/
.DS_Store

# Item 2.4's worktrees. Each holds a source tree plus a Linux build directory,
# and `build-*/` above is anchored to the context root so it does not cover the
# ones nested inside these. Excluded for the same reason as the rest of this
# file: the image never COPYs the repository, so uploading them would only make
# `docker compose build` slower.
.worktrees/
