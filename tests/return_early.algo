fn describe(n) {
    if n < 0 {
        print 0 - 1
        return
    }
    if n == 0 {
        print 0
        return
    }
    print 1
}

fn noReturnAtAll(n) {
    print n
}

fn firstEvenUpTo(limit) {
    i = 1
    while i <= limit {
        if i == 4 {
            return i
        }
        i = i + 1
    }
    return 0
}

print describe(0 - 5)
print describe(0)
print describe(5)
print noReturnAtAll(7)
print firstEvenUpTo(10)
print firstEvenUpTo(2)
