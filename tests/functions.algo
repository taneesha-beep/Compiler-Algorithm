fn add(a, b) {
    return a + b
}

fn square(n) {
    return n * n
}

fn hypotenuseSquared(a, b) {
    return add(square(a), square(b))
}

fn answer() {
    return 42
}

fn classify(n) {
    if n < 0 {
        return 0 - 1
    } else if n == 0 {
        return 0
    }
    return 1
}

fn subtract(a, b) {
    return a - b
}

fn digits(a, b, c) {
    return a * 100 + b * 10 + c
}

fn sumTo(limit) {
    total = 0
    i = 1
    while i <= limit {
        total = total + i
        i = i + 1
    }
    return total
}

print add(2, 3)
print square(7)
print hypotenuseSquared(3, 4)
print answer()
print add(answer(), square(2))
print classify(0 - 9)
print classify(0)
print classify(9)
print sumTo(100)
print add(1, 2) == 3
print subtract(10, 3)
print digits(1, 2, 3)
print subtract(subtract(100, 10), 1)
