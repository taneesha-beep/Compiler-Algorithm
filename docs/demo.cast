[0.016, "o", "\u001b[1;33m# 1. the front end -- a deliberate fault, and the diagnostic it renders\u001b[0m\r\n"]
[1.108, "o", "\u001b[1;36mtests\u001b[0m $ cat error_int_overflow.algo\r\n"]
[0.614, "o", "total = 9223372036854775807\r\nprint total + 1\r\n"]
[0.001, "o", "\r\n"]
[0.705, "o", "\u001b[1;36mtests\u001b[0m $ ../build/algo error_int_overflow.algo; echo \"exit $?\"\r\n"]
[0.618, "o", "error_int_overflow.algo:2:7: error: integer overflow in '+'\r\nprint total + 1\r\n      ^~~~~~~~~\r\n"]
[0.001, "o", "exit 70\r\n\r\n"]
[2.606, "o", "\u001b[1;33m# 2. the back end -- the same front end, dumping bytecode for a while loop\u001b[0m\r\n"]
[1.108, "o", "\u001b[1;36mtests\u001b[0m $ cat while_sum.algo\r\n"]
[0.620, "o", "i = 1\r\ntotal = 0\r\nwhile i <= 100 {\r\n    total = total + i\r\n    i = i + 1\r\n}\r\nprint total\r\n"]
[0.000, "o", "\r\n"]
[0.712, "o", "\u001b[1;36mtests\u001b[0m $ ../build/algo --dump while_sum.algo\r\n"]
[0.626, "o", "== chunk ==\r\n  code: 51 bytes  constants: 4  functions: 0  program frame: 2 slots\r\n\r\n== constants ==\r\n  #0  1\r\n  #1  0\r\n  #2  100\r\n  #3  1\r\n\r\n== functions ==\r\n  (none)\r\n\r\n== code ==\r\n  0000  line   1  CONST             0  ; 1\r\n  0003  line   1  STORE_LOCAL       0\r\n"]
[0.000, "o", "  0006  line   2  CONST             1  ; 0\r\n  0009  line   2  STORE_LOCAL       1\r\n  0012  line   3  LOAD_LOCAL        0\r\n  0015  line   3  CONST             2  ; 100\r\n"]
[0.000, "o", "  0018  line   3  GT\r\n"]
[0.000, "o", "  0019  line   3  NOT\r\n  0020  line   3  JUMP_IF_FALSE    46  ; -> 0046\r\n  0023  line   4  LOAD_LOCAL        1\r\n  0026  line   4  LOAD_LOCAL        0\r\n  0029  line   4  ADD\r\n  0030  line   4  STORE_LOCAL       1\r\n  0033  line   5  LOAD_LOCAL        0\r\n  0036  line   5  CONST             3  ; 1\r\n  0039  line   5  ADD\r\n  0040  line   5  STORE_LOCAL       0\r\n  0043  line   3  JUMP             12  ; -> 0012  (backward)\r\n"]
