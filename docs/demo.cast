[3.813, "o", "\u001b[1;33m# 3. both engines -- every golden case runs twice, tree-walker and VM,\u001b[0m\r\n"]
[1.115, "o", "\u001b[1;33m#    against the same .expected files. A test, not a benchmark.\u001b[0m\r\n"]
[1.115, "o", "\u001b[1;36mCompiler-Algo\u001b[0m $ ctest --test-dir build -R _tree | grep 'tests passed'\r\n"]
[1.407, "o", "100% tests passed, 0 tests failed out of 29\r\n"]
[0.003, "o", "\r\n"]
[1.208, "o", "\u001b[1;36mCompiler-Algo\u001b[0m $ ctest --test-dir build -R _vm   | grep 'tests passed'\r\n"]
