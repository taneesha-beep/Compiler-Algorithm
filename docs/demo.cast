[0.001, "o", "\r\n"]
[1.608, "o", "\u001b[1;33m# same bytes on stdout, same diagnostic on stderr, same exit code.\u001b[0m\r\n"]
[1.113, "o", "\u001b[1;33m# no timings here -- the numbers are cachegrind counts, taken under Linux.\u001b[0m\r\n"]
